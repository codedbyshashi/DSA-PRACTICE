//OPTIMAL SOLUTION
class Solution {
    public void generate(int ind,int n,int[] nums,List<Integer> current,List<List<Integer>> ans){
        if(ind==n){
            ans.add(new ArrayList<>(current));
            return;
        }
        current.add(nums[ind]);
        generate(ind+1,n,nums,current,ans);
        current.remove(current.size()-1);
        generate(ind+1,n,nums,current,ans);
    }
    public List<List<Integer>> subsets(int[] nums) {
        List<List<Integer>> ans = new ArrayList<>();
        List<Integer> current = new ArrayList<>();
        generate(0,nums.length,nums,current,ans);
        return ans;
        
    }
}
