//OPTIMAL APPROACH
class Solution {
     private void combinations(int ind, List<Integer> current, int sum, int n, List<List<Integer>> ans, int[] nums) {
        if (sum == 0) {
            ans.add(new ArrayList<>(current));
            return;
        }
        if (sum < 0 || ind == n) {
            return;
        }
        current.add(nums[ind]);
        combinations(ind+1, current, sum - nums[ind], n, ans, nums);
        current.remove(current.size() - 1);
        for(int i=ind+1;i<n;i++){
            if(nums[i]!=nums[ind]){
                combinations(i,current,sum,n,ans,nums);
                break;
            }
        }
    }
    public List<List<Integer>> combinationSum2(int[] candidates, int target) {
        int n = candidates.length;
        Arrays.sort(candidates);
        List<List<Integer>> ans = new ArrayList<>();
        List<Integer> current = new ArrayList<>();
        combinations(0, current, target, n, ans, candidates);
        return ans;
        
    }
}
