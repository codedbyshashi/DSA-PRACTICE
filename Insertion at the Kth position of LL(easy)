class Solution {
    public ListNode insertAtKthPosition(ListNode head, int X, int K) {
        ListNode newNode = new ListNode(X);

        // Case 1: empty list
        if (head == null) {
            if (K == 1) return newNode;
            else return null; // invalid position
        }

        // Case 2: insert at the head
        if (K == 1) {
            newNode.next = head;
            return newNode;
        }

        // Case 3: insert in middle or end
        int count = 1;
        ListNode temp = head;

        while (temp != null && count < K - 1) {
            temp = temp.next; 
            count++;
        }

        // if K > length + 1
        if (temp == null) return head;

        newNode.next = temp.next;
        temp.next = newNode;

        return head;
    }
}
