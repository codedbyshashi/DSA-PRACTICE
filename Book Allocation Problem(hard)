//LINEAR SEARCH
class Solution {
    public int countStu(int[] nums, int pages) {
        int n = nums.length;
        int stu = 1;
        int pagecount = 0;

        for (int i = 0; i < n; i++) {
            if (pagecount + nums[i] <= pages) {
                pagecount += nums[i];
            } else {
                pagecount = nums[i];
                stu++;
            }

        }
        return stu;
    }

    public int splitArray(int[] nums, int k) {
        int n = nums.length;
        if(k>n) return -1;
        int low=0,high=0;
        for(int i=0;i<n;i++){
            low = Math.max(low,nums[i]);
            high +=nums[i];
        }
        for(int pages = low;pages<=high;pages++){
            if(countStu(nums,pages)<=k){
                return pages;
            }
        }
        return -1;
        
    }
}
BINARY SEARCH
class Solution {
    public int countStu(int[] nums, int pages) {
        int n = nums.length;
        int stu = 1;
        int pagecount = 0;

        for (int i = 0; i < n; i++) {
            if (pagecount + nums[i] <= pages) {
                pagecount += nums[i];
            } else {
                pagecount = nums[i];
                stu++;
            }

        }
        return stu;
    }

    public int splitArray(int[] nums, int k) {
        int n = nums.length;
        if(k>n) return -1;
        int low=0,high=0;
        for(int i=0;i<n;i++){
            low = Math.max(low,nums[i]);
            high +=nums[i];
        }
        while(low<=high){
            int mid = (low+high)/2;
           if(countStu(nums,mid)>k){
            low=mid+1;
           }
           else{
            high = mid-1;
           }
        }
        return low;
        
    }
}
