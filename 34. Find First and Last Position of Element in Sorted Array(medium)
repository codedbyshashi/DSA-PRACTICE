//OPTIMAL SOLUTION USING BINARY SEARCH
class Solution {
    private int firstOcc(int[] nums,int target){
        int n = nums.length;
        int low=0,high=n-1;
        int ans = -1;
        while(low<=high){
            int mid = (low+high)/2;
            if(nums[mid]==target){
                ans = mid;
                high=mid-1;
            }
            else if(nums[mid]<target){
                low=mid+1;
            }
            else{
                high=mid-1;
            }
        }
        return ans;
    }
    private int lastOcc(int[] nums,int target){
        int n = nums.length;
        int low=0,high=n-1;
        int ans = -1;
        while(low<=high){
            int mid = (low+high)/2;
            if(nums[mid]==target){
                ans = mid;
                low=mid+1;
            }
            else if(nums[mid]<target){
                low=mid+1;
            }
            else{
                high=mid-1;
            }
        }
        return ans;
    }
    public int[] searchRange(int[] nums, int target) {
        int n = nums.length;
        int first = firstOcc(nums,target);
        if(first==-1) return new int[]{-1,-1};
        int last = lastOcc(nums,target);
        return new int[]{first,last};
    }
}
