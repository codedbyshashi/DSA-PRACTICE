/* Definition of singly Linked List:
class ListNode {
    int val;
    ListNode next;

    ListNode(int data1) {
        val = data1;
        next = null;
    }

    ListNode(int data1, ListNode next1) {
        val = data1;
        next = next1;
    }
}
*/

class Solution {
  public ListNode sortList(ListNode head) {
    if (head == null || head.next == null) {
      return head;
    }
    int c0 = 0, c1 = 0, c2 = 0;
    ListNode temp = head;
    while (temp != null) {
      if (temp.val == 0) {
        c0++;
      } else if (temp.val == 1) {
        c1++;
      } else {
        c2++;
      }
      temp = temp.next;
    }
    temp = head;
    while (temp != null) {
      if (c0 > 0) {
        temp.val = 0;
        c0--;
      } else if (c1 > 0) {
        temp.val = 1;
        c1--;
      } else {
        temp.val = 2;
        c2--;
      }
      temp = temp.next;
    }
    return head;
  }
}
