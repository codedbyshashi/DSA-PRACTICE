// OPTIMAL APPROACH(RECURSION METHOD)
class Solution {
    private final String[] map;
    public Solution(){
        map = new String[]{"","","abc","def","ghi","jkl","mno","pqrs","tuv","wxyz"};
    }
    private void combinations(int ind,String current,String digits,List<String> ans){
        if(ind==digits.length()){
            ans.add(current);
            return;
        }
        String s = map[digits.charAt(ind)-'0'];
        for(int i=0;i<s.length();i++){
            combinations(ind+1,current+s.charAt(i),digits,ans);
        }

    }
    public List<String> letterCombinations(String digits) {
        //your code goes here
        List<String> ans = new ArrayList<>();
        if(digits.length()==0) return ans;
        combinations(0,"",digits,ans);
        return ans;
    }
}
