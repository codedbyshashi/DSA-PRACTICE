class Solution {
    public int duplicateNumbersXOR(int[] nums) {

        Map<Integer, Integer> freq = new HashMap<>();

        // Count frequency
        for (int num : nums) {
            freq.put(num, freq.getOrDefault(num, 0) + 1);
        }

        int ans = 0;

        // XOR numbers that appear exactly twice
        for (Map.Entry<Integer, Integer> entry : freq.entrySet()) {
            if (entry.getValue() == 2) {
                ans ^= entry.getKey();
            }
        }

        return ans;
    }
}
