//OPTIMAL APPROACH(BINARY SEARCH)
class Solution {
  public int findKRotation(ArrayList<Integer> nums) {
    int n = nums.size();
    int index = -1;
    int ans = Integer.MAX_VALUE;
    int low = 0, high = n - 1;
    while (low <= high) {
      int mid = (low + high) / 2;
      // if arr is sorted without rotations
      if (nums.get(low) <= nums.get(high)) {
        if (nums.get(low) < ans) {
          index = low;
          ans = nums.get(low);
        }
        break;
      }
      // if left part is sorted update min
      if (nums.get(low) <= nums.get(mid)) {
        if (nums.get(low) < ans) {
          index = low;
          ans = nums.get(low);
        }
        low = mid + 1;
      } else {
        if (nums.get(mid) < ans) {
          index = mid;
          ans = nums.get(mid);
        }
        high = mid - 1;
      }
    }
    return index;
  }
}

