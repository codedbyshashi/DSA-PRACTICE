//BRUTE FORCE(LINEAR SEARCH)
class Solution {
  public int findKRotation(ArrayList<Integer> nums) {
    int n = nums.size();
    int ans = Integer.MAX_VALUE;
    int index = -1;

    for (int i = 0; i < n; i++) {
      if (nums.get(i) < ans) {
        ans = nums.get(i);
        index = i;
      }
    }
    return index;
  }
}
