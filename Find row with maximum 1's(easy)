//LINEAR SEARCH(O(NXM)COMPLEXITY
class Solution {
  public int rowWithMax1s(int[][] mat) {
    int n = mat.length, m = mat[0].length;
    int index = -1;
    int maxOnes = 0;
    for (int i = 0; i < n; i++) {
      int countOnes = 0;
      for (int j = 0; j < m; j++) {
        countOnes += mat[i][j];
      }
      if (countOnes > maxOnes) {
        maxOnes = countOnes;
        index = i;
      }
    }
    return index;
  }
}
//BINARY (O(n * log(m)))
class Solution {
  public int lowerBound(int[] nums, int n, int x) {
    int low = 0, high = n - 1;
    int ans = n;
    while (low <= high) {
      int mid = (low + high) / 2;
      if (nums[mid] >= x) {
        ans = mid;
        high = mid - 1;

      } else {
        low = mid + 1;
      }
    }
    return low;
  }

  public int rowWithMax1s(int[][] mat) {
    int n = mat.length, m = mat[0].length;
    int index = -1;
    int maxOnes = 0;
    for (int i = 0; i < n; i++) {
      int countOnes = m - lowerBound(mat[i], m, 1);
      if (countOnes > maxOnes) {
        maxOnes = countOnes;
        index = i;
      }
    }
    return index;
  }
}
