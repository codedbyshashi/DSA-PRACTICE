// LINEAR SEARCH(O(N))
class Solution {
    public int findPeakElement(int[] nums) {
        int n = nums.length;

        for (int i = 0; i < n; i++) {
            if ((i == 0 || nums[i - 1] < nums[i]) && (i == n - 1 || nums[i + 1] < nums[i])) {
                return i;
            }
        }
        return -1;

    }
}
// BINEAR SEARCH(O(logn))
class Solution {
    public int findPeakElement(int[] nums) {
        int n = nums.length;
        if(n==1) return 0;
        // checking for the first ele and last ele if it is peak ele
        if(nums[0]>nums[1]){
            return 0;
        }
        else if(nums[n-1]>nums[n-2]){
            return n-1;
        }
        int low = 1,high=n-2;
        while(low<=high){
            int mid = (low+high)/2;
            // checking if both before and after mid is less than mid,if true return mid
            if(nums[mid]>nums[mid-1] && nums[mid]>nums[mid+1]){
                return mid;
            }
            // if mid greater than before ele then it is in the increasing phase then peak ele must be in the right
            else if(nums[mid]>nums[mid-1] ){
                low=mid+1;
            }
            // if mid is less than before ele then it is in the decreasing phase peak ele must be in the left side of the array
            else{
                high=mid-1;
            }
        }
        return -1;
        
    }
}
