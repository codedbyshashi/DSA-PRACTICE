//BRUTE FORCE
class Solution {
    public boolean searchMatrix(int[][] matrix, int target) {
    int n = matrix.length;
    int m = matrix[0].length;
    if(n==0||m==0) return false;
    for (int i = 0; i < n; i++) {
      for (int j = 0; j < m; j++) {
        if (matrix[i][j] == target) {
          return true;
        }
      }
    }
    return false;
        
    }
}
// BETTER APPROACH
class Solution {
  public boolean binarySearch(int[] nums, int n, int x) {
    int low = 0, high = n - 1;
    while (low <= high) {
      int mid = (low + high) / 2;
      if (nums[mid] == x) {
        return true;
      } else if (nums[mid]  > x) {
        high = mid - 1;
      } else {
        low = mid + 1;
      }
    }
    return false;
  }

  public boolean searchMatrix(int[][] mat, int target) {
    int n = mat.length;
    int m = mat[0].length;
    if (n == 0 || m == 0) return false;
    for (int i = 0; i < n; i++) {
      if (mat[i][0] <= target && mat[i][m - 1] >= target) {
        return binarySearch(mat[i], m, target);
      }
    }
    return false;
  }
}
//OPTIMAL SOLUTION
class Solution {
    public boolean searchMatrix(int[][] matrix, int target) {
        int n = matrix.length;
        int m = matrix[0].length;
        int low =0,high=n*m-1;
        while(low<=high){
            int mid = (low+high)/2;
            int row = mid/m;
            int col = mid%m;
            if(matrix[row][col]==target){
                return true;
            }
            else if(matrix[row][col]<target){
                low = mid+1;
            }
            else{
                high = mid-1;
            }
        }
        return false;
        
    }
}
