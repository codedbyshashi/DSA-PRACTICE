//BRUTE FORCE
class Solution {
  public int findMedian(int[][] matrix) {
    int n = matrix.length;
    int m = matrix[0].length;
    List<Integer> flattened = new ArrayList<>();
    for (int i = 0; i < n; i++) {
      for (int j = 0; j < m; j++) {
        flattened.add(matrix[i][j]);
      }
    }
    Collections.sort(flattened);
    int k = flattened.size();
    return flattened.get(k / 2);
  }
}
