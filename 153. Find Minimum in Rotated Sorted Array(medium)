// OPTIMAL FOR THE DUPLICATE ARRAY TO FIND MIN
class Solution {
    public int findMin(int[] nums) {
        int low = 0, high = nums.length - 1;

        while (low < high) {
            int mid = (low + high) / 2;

            if (nums[mid] > nums[high]) {
                // Minimum must be on the right side
                low = mid + 1;
            } else if (nums[mid] < nums[high]) {
                // Minimum is on the left side including mid
                high = mid;
            } else {
                // nums[mid] == nums[high], shrink search space
                high--;
            }
        }
        return nums[high]; // low == high -> minimum element
    }
}

