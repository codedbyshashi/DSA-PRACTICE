//BRUTE FORCE
class Solution {
    public int sumSubarrayMins(int[] arr) {
        int n = arr.length;
        int mod = (int)1e9+7;
        int total = 0;
        for(int i=0;i<n;i++){
            int smallest=arr[i];
            for(int j=i;j<n;j++){
                smallest = Math.min(smallest,arr[j]);
                total +=smallest;
            }
        }
        return (int)total%mod;
        
    }
}
